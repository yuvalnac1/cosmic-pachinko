{
  "name": "cosmic-pachinko",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sim": "esbuild tools/sim/econ.ts --bundle --platform=node --log-level=error --outfile=node_modules/.sim/econ.cjs && node node_modules/.sim/econ.cjs",
    "sim:strength": "esbuild tools/sim/sim.ts --bundle --platform=node --log-level=error --outfile=node_modules/.sim/sim.cjs && node node_modules/.sim/sim.cjs",
    "sim:players": "esbuild tools/sim/players.ts --bundle --platform=node --log-level=error --outfile=node_modules/.sim/players.cjs && node node_modules/.sim/players.cjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}